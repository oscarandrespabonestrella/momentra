{
  "name": "@momentra/angular",
  "version": "0.1.0-alpha.0",
  "description": "Momentra is a modern, extensible Angular date and time component library providing beautiful, accessible, and highly configurable date pickers, calendars, time pickers, date-time pickers, and date range components.",
  "keywords": [
    "angular",
    "date picker",
    "datepicker",
    "time picker",
    "datetime",
    "date range",
    "calendar",
    "momentra"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oscarandrespabonestrella/momentra.git"
  },
  "bugs": {
    "url": "https://github.com/oscarandrespabonestrella/momentra/issues"
  },
  "homepage": "https://oscarandrespabonestrella.github.io/momentra/",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "date-fns": "^4.0.0",
    "luxon": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "date-fns": {
      "optional": true
    },
    "luxon": {
      "optional": true
    }
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/public-api.ts",
    "./date-fns": "./date-fns/public-api.ts",
    "./luxon": "./luxon/public-api.ts"
  }
}
